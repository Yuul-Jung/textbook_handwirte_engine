{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "전자교재 판서 단축키",
  "version": "34.0.0",
  "description": "기존 교재 파일을 수정하지 않고 단축키로 판서를 켜고 끕니다.",
  "permissions": ["activeTab", "scripting"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "판서 켜기/끄기 (Alt+Shift+Y)"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Y"}, "description": "판서 켜기/끄기"}}
}
